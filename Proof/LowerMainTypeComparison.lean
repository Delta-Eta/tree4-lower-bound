import LowerMainTypes

namespace LowerMainTypeComparison
open LowerMainTemplate LowerMainTypes

/-- Isomorphisms generated by exchanging the children of binary pair nodes.
    Literal subtemplates, including fixed markers, are retained. -/
inductive PairIso : Template → Template → Prop where
  | refl (p) : PairIso p p
  | direct {p q r s} : PairIso p r → PairIso q s → PairIso (binary p q) (binary r s)
  | crossed {p q r s} : PairIso p s → PairIso q r → PairIso (binary p q) (binary r s)

structure Comparison (p q : Template) : Prop where
  holes_eq : holes p=holes q
  cost_le : cost p≤cost q
  equal_cost_iso : cost p=cost q → PairIso p q

theorem comparison_refl (p : Template) : Comparison p p := ⟨rfl,le_rfl,fun _ => .refl p⟩

theorem comparison_of_strict_or_eq {p q : Template}
    (hh : holes p=holes q) (hc : p=q ∨ cost p<cost q) : Comparison p q := by
  rcases hc with rfl | hc
  · exact comparison_refl p
  · refine ⟨hh,hc.le,?_⟩
    intro he
    exact False.elim (hc.ne he)

theorem comparison_direct {p q r s : Template} (h1 : Comparison p r) (h2 : Comparison q s) :
    Comparison (binary p q) (binary r s) := by
  have hc1 := h1.cost_le
  have hc2 := h2.cost_le
  refine ⟨?_,?_,?_⟩
  · rw [holes_binary,holes_binary,h1.holes_eq,h2.holes_eq]
  · rw [cost_binary,cost_binary]
    omega
  · intro he
    rw [cost_binary,cost_binary] at he
    exact .direct (h1.equal_cost_iso (by omega)) (h2.equal_cost_iso (by omega))

theorem comparison_crossed {p q r s : Template} (h1 : Comparison p s) (h2 : Comparison q r) :
    Comparison (binary p q) (binary r s) := by
  have hc1 := h1.cost_le
  have hc2 := h2.cost_le
  refine ⟨?_,?_,?_⟩
  · rw [holes_binary,holes_binary,h1.holes_eq,h2.holes_eq]
    omega
  · rw [cost_binary,cost_binary]
    omega
  · intro he
    rw [cost_binary,cost_binary] at he
    exact .crossed (h1.equal_cost_iso (by omega)) (h2.equal_cost_iso (by omega))

theorem strict_of_not_iso {p q : Template} (h : Comparison p q) (hn : ¬ PairIso p q) : cost p<cost q :=
  lt_of_le_of_ne h.cost_le (fun he => hn (h.equal_cost_iso he))

#print axioms comparison_direct
#print axioms comparison_crossed
#print axioms strict_of_not_iso
end LowerMainTypeComparison
